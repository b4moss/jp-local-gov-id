{
  "name": "@b4moss/jp-local-gov-id-data",
  "version": "1.0.0-rc.10",
  "description": "全国地方公共団体コードヘルパ — 日本の全国地方公共団体コードのデータ（分割バイナリ）",
  "type": "module",
  "main": "./dataset.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dataset.js",
      "default": "./dataset.js"
    },
    "./index.json": "./index.json",
    "./prefectures.bin": "./prefectures.bin",
    "./prefectures/*": "./prefectures/*",
    "./dataset.js": "./dataset.js",
    "./decode.js": "./decode.js"
  },
  "files": [
    "index.json",
    "prefectures.bin",
    "prefectures/*.bin",
    "dataset.js",
    "decode.js",
    "index.d.ts",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "keywords": [
    "japan",
    "local-government",
    "municipality",
    "prefecture"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b4moss/jp-local-gov-id",
    "directory": "packages/jp-local-gov-id-data"
  },
  "publishConfig": {
    "access": "public"
  }
}
